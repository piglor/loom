# Copy to ignored `.env`, set mode 0600, and provide fresh local values.
# This file only documents configuration; never commit real credentials.
LOOM_POSTGRES_PASSWORD=
LOOM_DATABASE_URL=
LOOM_TEST_DATABASE_URL=
LOOM_API_TOKEN=
LOOM_URL=http://127.0.0.1:8080
LOOM_GITHUB_WEBHOOK_SECRET=
# Optional for private repositories; use a short-lived GitHub App installation token.
LOOM_GITHUB_API_TOKEN=
# Optional Hatchet connection for the native orchestration worker.
HATCHET_CLIENT_TOKEN=
# The API URL and worker gRPC address are distinct.
HATCHET_CLIENT_SERVER_URL=https://hatchet.piglor.com
# Set to a verified reachable host:port. Internal container DNS works only
# when the orchestration worker shares that network.
HATCHET_CLIENT_HOST_PORT=
HATCHET_CLIENT_TLS_STRATEGY=tls
