# Copy to ignored `.env`, set mode 0600, and provide fresh local values.
# This file only documents configuration; never commit real credentials.
LOOM_POSTGRES_PASSWORD=
LOOM_DATABASE_URL=
LOOM_TEST_DATABASE_URL=
LOOM_API_TOKEN=
# Browser account bootstrap. The email defaults to admin@example.com; leave
# the password empty to derive the initial password from LOOM_API_TOKEN.
LOOM_ADMIN_EMAIL=admin@example.com
LOOM_ADMIN_PASSWORD=
LOOM_AUTH_GITHUB_CLIENT_ID=
LOOM_AUTH_GITHUB_CLIENT_SECRET=
LOOM_AUTH_BOOTSTRAP=true
# Set false only when every user must arrive through an installed social provider.
LOOM_AUTH_EMAIL_REGISTRATION=true
# Optional 32+ character HMAC key shared by replicas. Empty generates a
# per-process key (safe for a single instance; pending OAuth flows reset on restart).
LOOM_AUTH_STATE_KEY=
LOOM_URL=http://127.0.0.1:8080
# One-release read-only fallbacks for an existing GitHub configuration. New
# connections store these values in OpenBao through the plugin store.
LOOM_GITHUB_WEBHOOK_SECRET=
LOOM_GITHUB_APP_INSTALL_URL=
LOOM_GITHUB_API_TOKEN=
LOOM_PUBLIC_URL=http://127.0.0.1:8080
# Local development OpenBao only. Server deployments use a scoped AppRole and TLS.
LOOM_OPENBAO_ADDR=http://127.0.0.1:18200
LOOM_OPENBAO_MOUNT=secret
LOOM_OPENBAO_TOKEN=loom-development-root-token
LOOM_OPENBAO_ROLE_ID=
LOOM_OPENBAO_SECRET_ID_FILE=
LOOM_OPENBAO_CA_CERT=
# Optional Hatchet connection for the native orchestration worker.
HATCHET_CLIENT_TOKEN=
# The API URL and worker gRPC address are distinct.
HATCHET_CLIENT_SERVER_URL=https://hatchet.piglor.com
# Set to a verified reachable host:port. Internal container DNS works only
# when the orchestration worker shares that network.
HATCHET_CLIENT_HOST_PORT=
HATCHET_CLIENT_TLS_STRATEGY=tls
